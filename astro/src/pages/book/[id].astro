---
// src/pages/book/[id].astro
import Layout from "../../layouts/BaseLayout.astro";

// Define an interface for the Book object based on available fields in the database
interface Book {
    id: string | number;
    title: string;
    isbn: string;
    publication_date: string;
    edition: string;
    partner: string;
    volume?: number;
    pages?: number;
    description?: string;
    cover?: string;
    pdf_path?: string;
}

export async function getStaticPaths() {
    const apiBaseUrl =
        import.meta.env.PUBLIC_API_URL || "http://localhost:8000/api/v1";
    let allBooks: Book[] = []; // Explicitly type allBooks
    let currentPage = 1;
    let totalPages = 1;

    try {
        // Fetch the first page to get pagination details
        const initialResponse = await fetch(
            `${apiBaseUrl}/books?page=${currentPage}`,
        );
        if (!initialResponse.ok) {
            console.error(
                `API error (page ${currentPage}): ${initialResponse.status} ${initialResponse.statusText}`,
            );
            const errorText = await initialResponse.text();
            console.error(`Error details: ${errorText}`);
            return [];
        }

        const initialResult = await initialResponse.json();
        if (initialResult.data && Array.isArray(initialResult.data)) {
            allBooks = allBooks.concat(initialResult.data);
        } else {
            console.error(
                "Initial fetched data is not in the expected format (missing data array).",
            );
            console.error("Received:", initialResult);
            return [];
        }

        totalPages = initialResult.last_page || 1;

        // Fetch remaining pages if any
        for (currentPage = 2; currentPage <= totalPages; currentPage++) {
            const response = await fetch(
                `${apiBaseUrl}/books?page=${currentPage}`,
            );
            if (!response.ok) {
                console.error(
                    `API error (page ${currentPage}): ${response.status} ${response.statusText}`,
                );
                // Decide if you want to stop or continue if a page fails
                continue; // Skipping this page on error
            }
            const result = await response.json();
            if (result.data && Array.isArray(result.data)) {
                allBooks = allBooks.concat(result.data);
            } else {
                console.warn(
                    `Fetched data for page ${currentPage} is not in the expected format.`,
                );
            }
        }

        if (allBooks.length === 0) {
            console.warn(
                "No books found after fetching all pages. Check API or logic.",
            );
            return [];
        }

        return allBooks
            .map((book) => {
                if (book && typeof book.id !== "undefined") {
                    return {
                        params: { id: String(book.id) },
                        props: { bookData: book },
                    };
                } else {
                    console.warn("Book object is invalid or missing id:", book);
                    return null; // Will be filtered out
                }
            })
            .filter((path) => path !== null); // Filter out any null paths due to invalid book data
    } catch (error) {
        console.error("Failed to fetch books for static paths:", error);
        return []; // Return empty array on error
    }
}

const { bookData } = Astro.props as { bookData: Book }; // Add type assertion for Astro.props

if (!bookData) {
    // This can happen if getStaticPaths returned an empty array or there was an issue
    // You might want to redirect to a 404 page or show an error message
    return Astro.redirect("/404"); // Or handle differently
}
