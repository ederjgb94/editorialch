                                                />
                                            </svg>
                                            ISBN: {book.isbn}
                                        </span>
                                    )
                                }
                                {
                                    book?.edition && (
                                        <span class="flex items-center">
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-4 w-4 mr-1 text-gray-500"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                                                />
                                            </svg>
                                            Edición: {book.edition}
                                        </span>
                                    )
                                }
                                {
                                    book?.pages && (
                                        <span class="flex items-center">
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-4 w-4 mr-1 text-gray-500"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"
                                                />
                                            </svg>
                                            Páginas: {book.pages}
                                        </span>
                                    )
                                }
                            </div>
                        </header>

                        {
                            book?.description && (
                                <section
                                    id="section-description"
                                    class="sd-abstract p-6 border-b border-gray-200"
                                >
                                    <h2 class="text-xl font-bold mb-4 text-gray-800">
                                        Descripción
                                    </h2>
                                    <div class="prose max-w-none">
                                        <p>{book.description}</p>
                                    </div>
                                </section>
                            )
                        }

                        <section id="section-pdf" class="sd-article-body p-6">
                            <h2 class="text-xl font-bold mb-4 text-gray-800">
                                Vista previa
                            </h2>
                            {
                                book?.pdf_path ? (
                                    <div class="border rounded-lg overflow-hidden h-[600px] bg-gray-100">
                                        <iframe
                                            src={`${API_URL}/books/${id}/pdf?embed=true`}
                                            width="100%"
                                            height="100%"
                                            style="border: none;"
                                            title={`Vista previa de ${book.title}`}
                                        />
                                    </div>
                                ) : (
                                    <div class="flex items-center justify-center h-[300px] bg-gray-100 rounded-lg border">
                                        <p class="text-gray-500 italic">
