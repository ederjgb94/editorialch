---
import BaseLayout from "../../layouts/BaseLayout.astro";

// API URL (using environment variable or default)
const API_URL =
    import.meta.env.PUBLIC_API_URL || "http://localhost:8000/api/v1";

// This function is required for dynamic routes in Astro
export async function getStaticPaths() {
    // This will generate a dynamic route that matches any ID
    // The actual data fetching happens in the component
    return [{ params: { id: undefined } }];
}

// Get the book ID from the URL
const { id } = Astro.params;

// Fetch book data
let book;
try {
    if (id) {
        const response = await fetch(`${API_URL}/books/${id}`);
        if (!response.ok) {
            throw new Error(`Error fetching book: ${response.status}`);
        }
        book = await response.json();
    }
} catch (error) {
    console.error("Error fetching book data:", error);
    // Handle error state
}
---

<BaseLayout title={book ? book.title : "Detalle del libro"}>
    <main class="sciencedirect-layout pb-20">
        <div class="sd-container max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 b-8">
            <!-- Breadcrumb navigation -->
