            </nav> -->

            <!-- Two-column layout: TOC left, Content+Sidebar right -->
            <div
                class="sd-two-column-wrapper flex flex-col lg:flex-row space-y-8 lg:space-y-0 lg:space-x-8"
            >
                <!-- Left sidebar with TOC -->
                <aside class="sd-toc-sidebar lg:w-1/4">
                    <div
                        class="sd-outline bg-white p-6 rounded-lg shadow-md sticky top-8"
                    >
                        <h3
                            class="text-lg font-bold mb-4 pb-2 border-b border-gray-200"
                        >
                            Índice
                        </h3>
                        <ul class="space-y-2">
                            <li>
                                <a
                                    href="#section-info"
                                    class="text-gray-700 hover:text-gray-900 flex items-center"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-4 w-4 mr-2"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                        ></path>
                                    </svg>
                                    Información general
                                </a>
                            </li>
                            <li>
                                <a
                                    href="#section-description"
                                    class="text-gray-700 hover:text-gray-900 flex items-center"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-4 w-4 mr-2"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                                        ></path>
                                    </svg>
                                    Descripción
                                </a>
                            </li>
                            <li>
                                <a
                                    href="#section-pdf"
                                    class="text-gray-700 hover:text-gray-900 flex items-center"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-4 w-4 mr-2"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"
                                        ></path>
                                    </svg>
                                    Vista previa
                                </a>
                            </li>
                        </ul>
                    </div>
                </aside>

                <!-- Right column with article and sidebar -->
                <div
                    class="sd-content-wrapper lg:w-3/4 flex flex-col md:flex-row md:space-x-6"
                >
                    <!-- Main content area -->
                    <article
                        class="sd-main-content bg-white rounded-lg shadow-md overflow-hidden md:w-2/3"
                    >
                        <header
                            class="sd-article-header p-6 border-b border-gray-200"
                        >
                            <h1
                                class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4"
                            >
                                {book?.title}
                            </h1>
                            <div class="sd-authors text-sm text-gray-600 mb-2">
                                Autor: {book?.partner || "No disponible"}
                            </div>
                            <div
                                class="sd-publication-info text-sm grid grid-cols-1 sm:grid-cols-2 gap-2"
                            >
                                {
                                    book?.publication_date && (
                                        <span class="flex items-center">
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-4 w-4 mr-1 text-gray-500"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                                />
                                            </svg>
                                            Publicación:{" "}
                                            {new Date(
                                                book.publication_date,
                                            ).toLocaleDateString()}
                                        </span>
                                    )
                                }
                                {
                                    book?.isbn && (
                                        <span class="flex items-center">
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-4 w-4 mr-1 text-gray-500"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
