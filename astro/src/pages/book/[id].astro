                                            este libro
                                        </p>
                                    </div>
                                )
                            }
                        </section>
                    </article>

                    <!-- Sidebar with metadata and tools -->
                    <aside class="sd-sidebar mt-6 md:mt-0 md:w-1/3">
                        <!-- Contenedor de la portada del libro -->
                        <div
                            class="sd-cover-image bg-white p-6 rounded-lg shadow-md"
                        >
                            <div class="cover-container mb-6">
                                {
                                    book?.cover ? (
                                        <img
                                            src={book.cover}
                                            alt={`Portada de ${book.title}`}
                                            class="w-full shadow-md border border-gray-200 rounded"
                                            onerror="this.onerror=null; this.parentElement.classList.add('cover-error'); this.style.display='none';"
                                        />
                                    ) : (
                                        <div class="aspect-[2/3] bg-gradient-to-br from-blue-500 to-blue-700 rounded flex items-center justify-center p-4">
                                            <span class="text-white font-bold text-lg rotate-[-30deg]">
                                                {book?.title}
                                            </span>
                                        </div>
                                    )
                                }
                            </div>

                            <!-- Sección de información general separada claramente de la portada -->
                            <div id="section-info" class="space-y-4">
                                <h3
                                    class="font-bold text-lg border-t border-gray-200 pt-6"
                                >
                                    Información general
                                </h3>
                                <ul class="space-y-2 text-sm">
                                    {
                                        book?.partner && (
                                            <li class="flex items-start">
                                                <span class="font-medium w-24">
                                                    Autor:
                                                </span>
                                                <span>{book.partner}</span>
                                            </li>
                                        )
                                    }
                                    {
                                        book?.publication_date && (
                                            <li class="flex items-start">
                                                <span class="font-medium w-24">
                                                    Publicado:
                                                </span>
                                                <span>
                                                    {new Date(
                                                        book.publication_date,
                                                    ).toLocaleDateString()}
                                                </span>
                                            </li>
                                        )
                                    }
                                    {
                                        book?.isbn && (
                                            <li class="flex items-start">
                                                <span class="font-medium w-24">
                                                    ISBN:
                                                </span>
                                                <span>{book.isbn}</span>
                                            </li>
                                        )
                                    }
                                    {
                                        book?.edition && (
                                            <li class="flex items-start">
                                                <span class="font-medium w-24">
                                                    Edición:
                                                </span>
                                                <span>{book.edition}</span>
                                            </li>
                                        )
                                    }
                                    {
                                        book?.volume && (
                                            <li class="flex items-start">
                                                <span class="font-medium w-24">
                                                    Volumen:
                                                </span>
                                                <span>{book.volume}</span>
                                            </li>
                                        )
                                    }
                                    {
                                        book?.pages && (
                                            <li class="flex items-start">
                                                <span class="font-medium w-24">
                                                    Páginas:
                                                </span>
                                                <span>{book.pages}</span>
                                            </li>
                                        )
                                    }
                                </ul>
                            </div>
                        </div>

                        <div
                            class="sd-actions mt-6 bg-white p-6 rounded-lg shadow-md"
                        >
                            {
                                book?.pdf_path && (
                                    <a
                                        href={`${API_URL}/books/${id}/pdf`}
                                        target="_blank"
                                        class="sd-btn sd-btn-primary w-full flex items-center justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none"
                                    >
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="h-5 w-5 mr-2"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                                            />
                                        </svg>
                                        Descargar PDF
                                    </a>
                                )
                            }
                            <button
                                class="sd-btn w-full flex items-center justify-center py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none"
                                onclick="navigator.clipboard.writeText(window.location.href); alert('Enlace copiado al portapapeles');"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-5 w-5 mr-2"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                                    ></path>
                                </svg>
                                Copiar enlace
                            </button>
                            <a
                                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(`Descubre "${book?.title}" en el catálogo de Editorial ScAsEd`)}&url=${encodeURIComponent(Astro.url.toString())}`}
                                target="_blank"
                                class="sd-btn w-full flex items-center justify-center py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="h-5 w-5 mr-2"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                                    ></path>
                                </svg>
                                Compartir
                            </a>
                        </div>
                    </aside>
                </div>
            </div>
        </div>
    </main>
</BaseLayout>

<style>
    /* ScienceDirect-inspired styles */
    .sd-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .cover-error {
        background: linear-gradient(135deg, #3182ce 0%, #2b6cb0 100%);
        aspect-ratio: 2/3;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.25rem;
    }

    .cover-error::after {
        content: attr(data-title);
        color: white;
        font-weight: bold;
        transform: rotate(-30deg);
        text-align: center;
        padding: 1rem;
    }

    @media (max-width: 768px) {
        .sd-two-column-wrapper {
            flex-direction: column;
        }

        .sd-toc-sidebar,
        .sd-content-wrapper {
            width: 100%;
        }
    }
</style>

<script>
    // Handle image errors for book covers
    document.addEventListener("DOMContentLoaded", () => {
        const coverImage = document.querySelector<HTMLImageElement>(
            ".sd-cover-image img",
        );
        if (coverImage) {
            coverImage.addEventListener("error", (e) => {
                const img = e.target as HTMLImageElement;
                const container = img.parentElement;

                if (container) {
                    const bookTitle = img.alt.replace("Portada de ", "");

                    // Create fallback cover with title
                    const fallback = document.createElement("div");
                    fallback.className =
                        "aspect-[2/3] bg-gradient-to-br from-blue-500 to-blue-700 rounded flex items-center justify-center p-4";
                    fallback.innerHTML = `<span class="text-white font-bold text-lg rotate-[-30deg]">${bookTitle}</span>`;

                    // Hide the img and show fallback
                    img.style.display = "none";
                    container.prepend(fallback);
                }
            });
        }
    });
</script>
