---
import BaseLayout from "../layouts/BaseLayout.astro";
import StaticPagination from "../components/book/StaticPagination.astro";
---

<BaseLayout title="Libros">
    <!-- Título principal -->
    <h1
        id="top-of-page"
        class="text-2xl md:text-3xl font-bold text-center text-gray-800 mb-3 sm:mb-4 md:mb-6 lg:mb-8 px-4 sm:px-6 lg:px-20"
    >
        Catálogo ScAsEd
    </h1>

    <!-- Texto promocional -->
    <div
        class="max-w-3xl mx-auto mb-4 sm:mb-6 text-center px-4 sm:px-6 lg:px-10"
    >
        <p class="text-sm sm:text-base text-gray-700 italic">
            Con nuestro catálogo contribuimos a promover el pensamiento crítico,
            la creación literaria, la cultura y el diálogo entre la Universidad
            y la sociedad.
        </p>
    </div>
    <div class="max-w-5xl mx-auto px-2 sm:px-4 md:px-6 lg:px-10">
        <StaticPagination />
    </div>
    <div class="h-10"></div>
</BaseLayout>

<style>
    /* Estilos adicionales para responsividad */
    @media (max-width: 480px) {
        #top-of-page {
            margin-top: 1rem;
        }
    }
</style>
