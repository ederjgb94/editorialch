---
interface Props {
    image: string;
    title: string;
    author: string;
    href: string;
}

// Receive the book data as props
const { image, title, author, href } = Astro.props;

// Imagen por defecto en caso de que no haya portada
const defaultImage = "/images/no-cover.jpg";
---

<div
    class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow flex flex-col h-full"
>
    <div class="flex-grow relative">
        {
            image ? (
                <img
                    src={image}
                    alt={`Portada de ${title}`}
                    class="w-full h-full object-cover"
                    onerror="this.onerror=null; this.src='/images/no-cover.jpg'; this.alt='Sin portada';"
                />
            ) : (
                <div class="w-full h-full flex items-center justify-center bg-gray-200 p-4 text-center">
                    <span class="text-gray-600 font-medium">Sin portada</span>
                </div>
            )
        }
    </div>
    <div class="p-4">
        <h3 class="font-bold text-lg mb-2 text-gray-800">
            {title}
        </h3>
        <p class="text-sm text-gray-600 mb-2">
            {author}
        </p>
        <div class="flex justify-end">
            <a
                href={href}
                class="text-sm bg-gray-600 hover:bg-gray-700 text-white px-3 py-1 rounded"
            >
                Ver detalles
            </a>
        </div>
    </div>
</div>
