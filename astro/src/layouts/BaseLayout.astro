---
import "../styles/global.css";
import NavBar from "@/components/navbar/index.astro";
import Footer from "@/components/footer/index.astro";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title} - Editorial ScAsEd</title>
        <meta
            name="description"
            content="Catálogo de libros de Editorial ScAsEd"
        />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&display=swap"
            rel="stylesheet"
        />
        <slot name="head" />
    </head>
    <body class="bg-gray-50">
        <div class="flex-grow w-full">
            <NavBar />
            <main>
                <slot />
            </main>
        </div>
        <Footer />
    </body>
</html>
